        ["O'rta rod", "**оно**", "`-о`, `-е`, `-мя`", "**моё**", "**новое**", "**одно**"],
        ["Ko'plik", "**они**", "`-ы`, `-и`, `-а`", "**мои**", "**новые**", "**одни**"]
      ]
    },
